# Yoosr Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# ============================================================
# Clerk Authentication
# Get from: https://dashboard.clerk.com → API Keys
# ============================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Clerk JWT Issuer (required for Convex auth)
# Get from: Clerk Dashboard → JWT Templates → your template → Issuer URL
# Example: https://your-domain.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Clerk Webhook Signing Secret (required for webhook verification)
# Get from: Clerk Dashboard > Webhooks > [your webhook] > Signing Secret
CLERK_WEBHOOK_SECRET=whsec_...

# ============================================================
# Convex Backend
# Get from: npx convex dev (or your Convex dashboard)
# ============================================================
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Convex Site URL (for HTTP endpoint access, e.g., widget API proxy)
# Same domain as CONVEX_URL
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-project.convex.cloud

# ============================================================
# OpenRouter (AI / LLM)
# Get from: https://openrouter.ai/keys
# Required for AI bot features (knowledge base embedding, AI tasks)
# ============================================================
OPENROUTER_API_KEY=sk-or-...

# AI Rate Limiting (max AI calls per project per hour)
AI_RATE_LIMIT_PER_HOUR=100

# LLM Retry Configuration (for OpenRouter call resilience)
LLM_RETRY_MAX_ATTEMPTS=3     # Max retries for OpenRouter calls
LLM_RETRY_BASE_DELAY_MS=1000 # Base delay before first retry (exponential backoff)

# Knowledge Base Embedding Configuration
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free  # Model used for knowledge base embeddings
EMBEDDING_DIMENSIONS=2048                                   # Vector dimensions for the model

# ============================================================
# Telegram Webhook (optional)
# Configure a secret_token when calling setWebhook API.
# The secret is stored per-integration in the database.
# Telegram webhooks use POST only — GET returns 405.
# ============================================================

# ============================================================
# Feature Flags (comma-separated key:value pairs)
# Example: ai_bot:true,advanced_analytics:false,custom_integrations:true
# ============================================================
FEATURE_FLAGS=ai_bot:true,advanced_analytics:true,custom_integrations:true

# ============================================================
# CI/CD Secrets (configure in GitHub repo settings)
# These are NOT set in .env files — they're GitHub Secrets
#
# Required GitHub Secrets:
# - CONVEX_DEPLOY_KEY: From npx convex key:new
# - VERCEL_TOKEN: From Vercel Account > Settings > Tokens
# - VERCEL_ORG_ID: From Vercel team settings
# - VERCEL_PROJECT_ID: From Vercel project settings (production)
# - VERCEL_PROJECT_ID_STAGING: From Vercel staging project (optional)
# - SLACK_WEBHOOK_URL: Slack incoming webhook for deployment notifications (optional)
#
# Workflow:
# - develop branch → staging deploy (deploy-staging job)
# - main branch → production deploy (deploy-convex + deploy-frontend jobs)
# - PRs → quality gates only (lint, test, build)
# ============================================================

# Staging environment (optional — for preview deployments)
VERCEL_PROJECT_ID_STAGING=  # Vercel project ID for staging

# ============================================================
# Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
# Required for push notification features
# ============================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ============================================================
# Encryption (for webhook secrets, integration credentials)
# Generate with: openssl rand -hex 32
# Required for channel integrations (Telegram, WhatsApp, etc.)
# ============================================================
ENCRYPTION_KEY=

# ============================================================
# Site URLs (optional, defaults used if not set)
# ============================================================
NEXT_PUBLIC_SITE_URL=https://yoosr.com
NEXT_PUBLIC_APP_URL=https://app.yoosr.com
