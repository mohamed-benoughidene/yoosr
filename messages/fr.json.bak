    "features": {
      "badge": "Plateforme centrale",
      "headline": "Tous les outils dont votre équipe de support a réellement besoin",
      "description": "De la première réponse automatisée au ticket final résolu — tout au même endroit.",
      "items": [
        {
          "title": "Moniteur en direct",
          "description": "Supervisez chaque conversation ouverte en temps réel. Filtrez par département, agent, étiquette, statut ou urgence SLA. Rejoignez n'importe quelle conversation instantanément."
        },
        {
          "title": "AI Bot Studio",
          "description": "Construisez des flux avec 19 types de blocs — réponse IA, recherche en base de connaissances, requêtes web, conditions, minuteurs et transfert humain. Sans code."
        },
        {
          "title": "Base de connaissances",
          "description": "Téléchargez vos documents et FAQ. Les bots récupèrent les réponses via recherche vectorielle — pas par simple correspondance de mots-clés. Réponses précises et sourcées."
        },
        {
          "title": "Analyses",
          "description": "Suivez les scores CSAT, l'usage des tokens par modèle et les questions sans réponse. Filtres par date. Voyez exactement où votre bot atteint ses limites."
        },
        {
          "title": "Suivi SLA",
          "description": "Définissez des délais de réponse par département. Surveillez le risque de violation en temps réel. Alertes automatiques avant l'expiration du SLA."
        },
        {
          "title": "Multi-canal",
          "description": "Web chat, Telegram, Facebook Messenger et Instagram DMs. Une seule boîte de réception pour tous les canaux utilisés par vos clients."
        }
      ]
    },
