    "cta": {
      "headline": "Votre équipe de support mérite de meilleurs outils.",
      "description": "Configurez votre espace de travail, intégrez le widget et lancez votre premier bot dès aujourd'hui — aucune carte de crédit requise.",
      "primary": "Commencer gratuitement →",
      "secondary": "Nous contacter"
    },
    "channels": {
      "badge": "Canaux",
      "headline": "Rencontrez vos clients là où ils se trouvent déjà",
      "description": "Une seule boîte de réception. Chaque canal. Les conversations de Telegram, Facebook, Instagram et votre site web — gérées en un seul endroit.",
      "items": [
        {
          "title": "Web Chat",
          "description": "Intégrez un widget sur n'importe quel site web avec une simple balise script. Couleurs, position et comportement entièrement personnalisables."
        },
        {
          "title": "Telegram",
          "description": "Connectez votre bot Telegram en quelques minutes. Messagerie bidirectionnelle complète avec prise en charge des fichiers et médias."
        },
        {
          "title": "Facebook Messenger",
          "description": "Gérez les conversations Messenger depuis la même boîte de réception unifiée, aux côtés de tous les autres canaux."
        },
        {
          "title": "Instagram DMs",
          "description": "Gérez les messages directs Instagram avec les mêmes flux de bot et outils d'agent que pour tous les autres canaux."
        }
      ]
    },
    "analytics": {
      "badge": "Analyses",
      "headline": "Tout voir, tout améliorer",
      "description": "Chaque conversation génère des données. Yoosr transforme ces données en décisions.",
      "items": [
        {
          "title": "Suivi CSAT",
          "description": "Collectez les notes de satisfaction après chaque conversation résolue. Visualisez la répartition des scores et les tendances dans le temps."
        },
        {
          "title": "Usage des Tokens",
          "description": "Surveillez la consommation de tokens IA par modèle. Comprenez le coût par conversation et optimisez votre sélection de modèles."
        },
        {
          "title": "Questions Sans Réponse",
          "description": "Voyez exactement quelles questions votre bot n'a pas pu traiter. Utilisez ces données pour combler les lacunes de votre base de connaissances."
        },
        {
          "title": "Taux de Violation SLA",
          "description": "Suivez le respect des délais de réponse par département avec des alertes de violation en temps réel avant qu'il ne soit trop tard."
        }
      ]
    },
    "orders": {
      "badge": "Commandes",
      "headline": "Capturez et gérez les leads de chaque conversation",
      "description": "Convertissez chaque conversation en prospect. Suivez le statut et informez l'équipe instantanément.",
      "items": [
        {
          "title": "Créer depuis le Chat",
          "description": "Un clic dans le Panneau Visiteur ouvre un nouveau formulaire de commande pré-rempli avec le nom et le canal du visiteur."
        },
        {
          "title": "Suivi de Statut",
          "description": "Mettez à jour les commandes de Nouveau à Confirmé puis à Expédié. Chaque changement est enregistré dans le journal d'activité."
        },
        {
          "title": "Export CSV",
          "description": "Téléchargez votre liste complète de commandes filtrée par date, statut ou département. Prêt pour n'importe quel CRM ou entrepôt de données."
        },
        {
          "title": "Notifications d'Équipe",
          "description": "Les agents sont notifiés à chaque mise à jour de commande. Rien ne passe à travers les mailles du filet au sein de votre équipe."
        }
      ]
    },
    "testimonials": {
      "badge": "Témoignages clients",
      "headline": "Les équipes de support dans toute la région MENA choisissent Yoosr",
      "items": [
